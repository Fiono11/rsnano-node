+/// Where a block sits here and the parent it names
+pub(crate) type Placement = (Account, u64, BlockHash);
+
+/// RAI: the vote records behind a lock of their own. A received vote is
+/// recorded without the elections lock, which the votes' application needs
+/// exclusively: recording is about a third of that time. Every method locks
+/// for its own duration and hands out no reference, so no caller holds the
+/// lock while it calls back in. Lock order: the elections lock, then this
+/// one; nothing takes the elections lock while holding this one.
+#[derive(Clone, Default)]
+pub(crate) struct SharedVoteRecords(Arc<Mutex<VoteRecords>>);
+
+impl SharedVoteRecords {
+    fn lock(&self) -> MutexGuard<'_, VoteRecords> {
+        self.0.lock().unwrap()
+    }
+
+    /// See [`VoteRecords::record_vote`]
+    pub fn record_vote(&self, vote: &Arc<Vote>, placed: &[(BlockHash, Option<Placement>)]) {
+        self.lock().record_vote(vote, placed)
+    }
+
+    /// See [`VoteRecords::place_and_record`]
+    pub fn place_and_record(&self, vote: &Vote, hash: &BlockHash, placement: Placement) {
+        self.lock().place_and_record(vote, hash, placement)
+    }
+
+    pub fn support_vote(&self, vote: &Arc<Vote>, hashes: impl IntoIterator<Item = BlockHash>) {
+        self.lock().support_vote(vote, hashes)
+    }
+
+    pub fn place(&self, epoch: ConsensusEpoch, hash: &BlockHash, slot: AccountSlot) {
+        self.lock().place(epoch, hash, slot)
+    }
+
+    /// Reads the support held for a block in an epoch. `read` must not call
+    /// back into the records.
+    pub fn with_support<R>(
+        &self,
+        epoch: ConsensusEpoch,
+        hash: &BlockHash,
+        read: impl FnOnce(&HashSupport) -> R,
+    ) -> Option<R> {
+        self.lock().support(epoch, hash).map(read)
+    }
+
+    /// The blocks with notarization-only votes in an epoch
+    pub fn late_notarized_hashes(&self, epoch: ConsensusEpoch) -> Vec<BlockHash> {
+        self.lock()
+            .late_notarized_blocks(epoch)
+            .map(|(hash, _)| *hash)
+            .collect()
+    }
+
+    pub fn has_settled_vote(
+        &self,
+        epoch: ConsensusEpoch,
+        voter: &PublicKey,
+        hash: &BlockHash,
+        base: Option<BlockHash>,
+    ) -> bool {
+        self.lock().has_settled_vote(epoch, voter, hash, base)
+    }
+
+    pub fn has_late_vote(
+        &self,
+        epoch: ConsensusEpoch,
+        voter: &PublicKey,
+        hash: &BlockHash,
+    ) -> bool {
+        self.lock().has_late_vote(epoch, voter, hash)
+    }
+
+    pub fn has_vote(
+        &self,
+        epoch: ConsensusEpoch,
+        voter: &PublicKey,
+        hash: &BlockHash,
+        kind: ResidualKind,
+    ) -> bool {
+        self.lock().has_vote(epoch, voter, hash, kind)
+    }
+
+    /// The signed votes held for the blocks in the epoch and every earlier
+    /// one, each vote once
+    pub fn votes_until(&self, epoch: ConsensusEpoch, hashes: &[BlockHash]) -> Vec<Arc<Vote>> {
+        let records = self.lock();
+        let mut votes: Vec<Arc<Vote>> = Vec::new();
+        for hash in hashes {
+            for support in records.support_until(epoch, hash) {
+                for vote in support.votes() {
+                    if !votes.iter().any(|held| Arc::ptr_eq(held, vote)) {
+                        votes.push(vote.clone());
+                    }
+                }
+            }
+        }
+        votes
+    }
+
+    pub fn voter_marks(
+        &self,
+        voter: &PublicKey,
+        hash: &BlockHash,
+    ) -> Vec<(ConsensusEpoch, bool, bool, usize)> {
+        self.lock().voter_marks(voter, hash)
+    }
+
+    pub fn votes_of(
+        &self,
+        epoch: ConsensusEpoch,
+        voter: &PublicKey,
+    ) -> Vec<(CertifiedBlock, ResidualKind, BlockHash)> {
+        self.lock().votes_of(epoch, voter)
+    }
+
+    pub fn trim_before(
+        &self,
+        epoch: ConsensusEpoch,
+        discharges: impl Fn(ConsensusEpoch, &AccountSlot) -> bool,
+    ) {
+        self.lock().trim_before(epoch, discharges)
+    }
+
+    pub fn len(&self) -> usize {
+        self.lock().len()
+    }
+}
