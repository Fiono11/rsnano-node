 impl VoteRecords {
+    /// RAI: a received account vote: indexed by every block it names,
+    /// whether or not the block is placed here yet, and placed and recorded
+    /// for each block with a placement. Close-election kinds are not
+    /// account votes and are ignored.
+    pub fn record_vote(&mut self, vote: &Arc<Vote>, placed: &[(BlockHash, Option<Placement>)]) {
+        if matches!(vote.kind(), VoteKind::Timeout | VoteKind::Abstain) {
+            return;
+        }
